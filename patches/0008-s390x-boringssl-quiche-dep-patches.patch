diff --git a/bazel/quiche_s390x.patch b/bazel/quiche_s390x.patch
new file mode 100644
index 0000000..5120bbf
--- /dev/null
+++ b/bazel/quiche_s390x.patch
@@ -0,0 +1,40 @@
+--- a/quiche/quic/core/quic_inlined_string_view.h
++++ b/quiche/quic/core/quic_inlined_string_view.h
+@@ -54,7 +54,7 @@
+     if (source.size() > kMaxInlinedSize) {
+       ViewRep rep;
+       rep.data = source.data();
+-      rep.size = source.size();
++      rep.size = NormalizeRepSize(source.size());
+       memcpy(&data_, &rep, sizeof(rep));
+       set_last_byte(kNotInlinedMarker);
+       return;
+@@ -113,7 +113,18 @@
+     size_t size;
+   };
+   static_assert(sizeof(ViewRep) <= kSize);
+-  static_assert(absl::endian::native == absl::endian::little);
++
++  // The non-inlined representation overlaps the marker/length byte at
++  // data_[kSize-1] with the most-significant byte of ViewRep::size, which only
++  // lines up on little-endian. On big-endian we byte-reverse the stored size so
++  // its MSB lands at data_[kSize-1], matching the little-endian layout. The
++  // transform is its own inverse, so the same helper is used on read and write.
++  static size_t NormalizeRepSize(size_t v) {
++    if constexpr (absl::endian::native != absl::endian::little) {
++      return absl::byteswap(v);
++    }
++    return v;
++  }
+ 
+   // Accessors for ViewRep; necessary to work around C++ strict aliasing
+   // limitations.  Clang will turn this into direct field access at `-O1`.
+@@ -125,7 +136,7 @@
+   size_t view_rep_size() const {
+     ViewRep rep;
+     memcpy(&rep, data_, sizeof(rep));
+-    return rep.size;
++    return NormalizeRepSize(rep.size);
+   }
+   // Those casts should be valid as long as uint8_t is unsigned char.
+   const uint8_t& last_byte() const {
